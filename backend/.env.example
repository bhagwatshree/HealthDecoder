# INTERIM SECRET STORAGE. Filling these in locally is fine for development, but this file is
# not where production credentials should live long-term -- the plan is to move them to the
# shared git-secrets repo and then to AWS Secrets Manager, with the Lambda reading them at
# startup instead of from a deployed .env. Anything added here should be assumed to need
# migrating later, so keep the variable NAMES stable even while the values are placeholders.

# Backend Server Port
PORT=3000

# PostgreSQL Connection Credentials (for local development)
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=medical_db
PGPORT=5432

# Neon PostgreSQL connection string (for AWS Lambda deployment).
# If set, this takes priority over the individual PG* variables above.
# Get yours from https://neon.tech (free tier, no credit card).
# DATABASE_URL=postgres://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Gemini API Key (Generate one at Google AI Studio). Kept for backward compatibility —
# used as a single-key fallback if GEMINI_API_KEYS below isn't set.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Pool of Gemini API keys for the free tier, comma-separated. Each key should be its own
# Google Cloud project (its own free-tier quota). Every logged-in free user is deterministically
# assigned to ONE key in this pool (see backend/keyPool.js), so adding more keys here directly
# raises how many free users the app can support without them competing for the same quota.
# Example: GEMINI_API_KEYS=key_for_project_1,key_for_project_2,key_for_project_3
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_HERE

# Sarvam AI API Key (Generate one at Sarvam AI Dashboard)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# --- Auth / per-user free tier ---
# Required — the server refuses to start without it. Secret used to sign login sessions
# (JWTs). Set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Required — the server refuses to start without it. Secret used to encrypt users' own API
# keys at rest (AES-256-GCM). Must be a DIFFERENT value from JWT_SECRET — a single leaked
# secret must not compromise both session tokens and encrypted-at-rest API keys.
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# How many free AI "issuances" (roughly: app sessions/days of scanning) each free-tier
# user gets per day before being asked to add their own key. See backend/keyPool.js.
FREE_TIER_DAILY_LIMIT=50

# --- Google OAuth / SSO ---
# Get these from Google Cloud Console credentials page
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# --- Phone (MSISDN) OTP login/signup, via Firebase Phone Auth ---

# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the entire downloaded JSON file's contents here as ONE LINE (no line breaks).
# Leave blank to disable phone-OTP auth — email/password signup and login keep working.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Model / rate-limit tuning (all optional; defaults shown) ---

# Which Gemini model every AI call uses. Keep this in step with the Android/iOS clients'
# expectations — the apps don't send a model name, the server chooses it.
GEMINI_MODEL=gemini-3.6-flash

# Per-key requests-per-minute ceiling used to pace calls so a bulk scan doesn't burst past
# the free tier's limit and turn every request into a 429. See backend/keyPool.js.
GEMINI_RPM_LIMIT=15

# Force TLS on the PostgreSQL connection when using the individual PG* variables above.
# Set to `require` for any managed/hosted database. Ignored when DATABASE_URL is used, since
# that carries its own ?sslmode= parameter.
PGSSLMODE=

# Optional — MapmyIndia key for the (not yet enabled) nearby-labs lookup. Leave blank; nothing
# reads it today beyond a feature-gated placeholder in server.js.
MAPMYINDIA_API_KEY=

# --- Device attestation (Android Play Integrity; no iOS client ships from this repo) ---
# Proves a caller is a genuine build of the app on a real device before it is issued a device
# token. DEFAULT OFF. Turning it on rejects every client that does not yet send an attestation,
# which includes every already-installed app — ship attesting clients first, wait for adoption,
# then flip. Check rollout state at GET /api/device/attestation-status.
ATTESTATION_ENFORCE_ANDROID=false

# Must match the app's applicationId. The service account in FIREBASE_SERVICE_ACCOUNT_JSON
# additionally needs the Play Integrity API role.
ANDROID_PACKAGE_NAME=com.healthdecoder.app

# --- Abuse rate limiting (per source IP; independent of attestation) ---
# Caps how many times a single IP can call the sensitive endpoints below in a rolling window,
# regardless of whether attestation is enforced. See backend/rateLimiter.js. Defaults are
# generous enough for a shared/NAT'd network (office wifi, a clinic's front desk) while still
# blocking a scripted loop, which blows past them in seconds.
DEVICE_REGISTER_IP_LIMIT_PER_HOUR=20
AUTH_IP_LIMIT_PER_HOUR=30

# --- Monitoring / CloudWatch alarms ---
# The two things most able to cost real money or break the app overnight are both invisible to
# CloudWatch by default: Gemini key usage (accounted in Postgres, not in AWS) and the Neon
# database (not an AWS resource, so AWS publishes no metrics for it at all). backend/metrics.js
# emits the first from the request path as Embedded Metric Format; backend/monitor.js polls the
# second on a schedule. See the Monitoring section of template.yaml for the alarms themselves.
#
# These are deploy-time CloudFormation parameters, passed by scripts/gen-samconfig.js and stored
# as GitHub Actions secrets in CI. Any that are unset are omitted from the deploy, leaving the
# stack's current value untouched.

# 'active' creates the 20 alarms + the hourly Neon monitor and emits metrics. 'sleep' removes the
# alarms and the monitor and stops the API emitting, which costs nothing -- alarms are billed per
# alarm that EXISTS, not per alarm that fires, so silencing the metrics alone would still leave
# ~$1/month on the table. The SNS topic and dashboard survive sleep (both free), so the confirmed
# email subscription is not lost and the last test run's graphs stay readable for 15 months.
#
# Defaults to 'sleep' in template.yaml: waking monitoring should always be a deliberate act, never
# a side effect of a deploy that forgot to mention it. In CI this is a workflow_dispatch dropdown
# rather than a secret -- Actions tab > Backend deploy > Run workflow > monitoring_mode.
MONITORING_MODE=sleep

# Address every alarm notifies. AWS emails a confirmation link on the FIRST deploy that sets this
# and delivers nothing until it is clicked -- an unconfirmed address means silent alarms.
ALERT_EMAIL=

# Neon API key (Neon Console > Account settings > API keys) and project id (Project > Settings >
# General). Used read-only, once an hour, to read project consumption. Leave blank to skip Neon
# quota monitoring; the table-growth metrics still publish without it.
NEON_API_KEY=
NEON_PROJECT_ID=

# Your Neon PLAN's allowances -- not read from the API, so check them in the Neon console and set
# them here. The alarms watch percentage-of-these rather than raw numbers, so a plan change means
# editing these two values instead of every threshold. Defaults below are the free plan.
NEON_STORAGE_LIMIT_BYTES=536870912
NEON_COMPUTE_HOURS_LIMIT=191.9

# Alarm when estimated Gemini spend crosses these. Estimated from pricing.js list prices against
# reported token counts -- close enough to act on, not an invoice.
GEMINI_HOURLY_SPEND_USD=0.50
GEMINI_DAILY_SPEND_USD=2.00

# Sarvam is the other paid AI provider (per page for doc digitization, per 10k chars for
# translate/TTS). Previously unmonitored -- see MONITORING.md.
SARVAM_DAILY_SPEND_USD=1.00

# Abuse-shaped thresholds. Invocations counts EVERY entry point including the Function URL the AI
# proxy uses; the 4xx alarm sees only the API Gateway routes. Each OTP verification is a billed SMS
# (10k/month free), so volume there is cost, not just a signal.
INVOCATION_BURST_PER_5MIN=200
APIGW_4XX_PER_5MIN=30
OTP_VERIFICATIONS_PER_5MIN=15

# '1' publishes the per-key / per-reason / per-scope breakdown metrics; '0' publishes only the
# undimensioned totals. Every alarm watches the totals, so '0' costs diagnostic detail and never
# coverage -- it is the lever to pull if the custom-metric bill looks high, since one dimension
# with six values is six billable metrics rather than one.
METRICS_DETAIL=1

# Local dev only. Metrics are off outside Lambda so `npm run dev` doesn't print EMF JSON at the
# terminal; set to 1 to see what would be emitted, or 0 to silence it in Lambda without a deploy.
# METRICS_ENABLED=1
